{
  "name": "Protección de ramas principales",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/develop"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "Auditoría de cumplimiento"
          },
          {
            "context": "Pruebas y cobertura"
          },
          {
            "context": "Análisis de seguridad (SonarCloud)"
          },
          {
            "context": "Construir imagen Docker"
          },
          {
            "context": "Escaneo de vulnerabilidades"
          },
          {
            "context": "Desplegar en Kubernetes y verificar monitoreo"
          }
        ]
      }
    }
  ]
}
